<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AI-Warp-Engine</AssemblyName>
    <RootNamespace>AiWarpEngine</RootNamespace>
    <Version>6.4.37</Version>
    <Authors>River Lyle Reuveni</Authors>
    <Company>River Lyle Reuveni (Imortalimp)</Company>
    <Product>AI WARP ENGINE</Product>
    <Description>Glitch visual synthesizer and audio-reactive media playground</Description>
    <Copyright>(c) 2026 River Lyle Reuveni - imortalimp.nl - CC0 1.0 / The Unlicense</Copyright>
    <PackageProjectUrl>https://imortalimp.nl</PackageProjectUrl>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ai_warp_engine\*.html;..\ai_warp_engine\*.js;..\ai_warp_engine\*.css;..\ai_warp_engine\*.json"
             Link="app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ai_warp_engine\audio\*.mp3;..\ai_warp_engine\audio\*.mp4;..\ai_warp_engine\audio\*.jpg"
             Link="app\audio\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" Link="app\favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ai_warp_engine\THREE-LICENSE.txt" Link="app\THREE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <FFmpegRoot Condition="'$(FFmpegRoot)' == ''">$(AIWARP_FFMPEG_ROOT)</FFmpegRoot>
  </PropertyGroup>
  <Target Name="RequireBundledFFmpeg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(FFmpegRoot)\bin\ffmpeg.exe') Or !Exists('$(FFmpegRoot)\LICENSE') Or !Exists('$(FFmpegRoot)\README.txt')"
           Text="FFmpeg and its license/build notices are required. Run shell\build.ps1 or set FFmpegRoot to an extracted FFmpeg distribution." />
  </Target>
  <ItemGroup>
    <Content Include="$(FFmpegRoot)\bin\ffmpeg.exe" Link="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FFmpegRoot)\LICENSE" Link="tools\FFMPEG-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FFmpegRoot)\README.txt" Link="tools\FFMPEG-README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>